# =============================================================================
# Rayan Couture / CouturePro — environment template
# =============================================================================
# Copy this file and fill in REAL values. Never commit the copy.
#
#   cd <repo root>
#   cp backend/.env.example .env      # Docker Compose reads .env at the root
#   docker compose up -d --build
#   docker compose exec api npm run setup-shop
#
# Every shop is an isolated deployment with its own database, so each shop
# gets its OWN .env with its own DB_PASSWORD, JWT_SECRET and seed accounts.
# See docs/DEPLOYMENT.md and docs/ONBOARDING_NEW_SHOP.md.
#
# This template contains variable NAMES and formats only — no real secrets.
# =============================================================================

# ---- required: database ------------------------------------------------------
# Password for the bundled postgres container. Generate a fresh one per shop:
#   openssl rand -base64 32
DB_PASSWORD=

# Only needed when running the API OUTSIDE Docker (local dev, tests). Inside
# Compose this is built automatically from DB_PASSWORD.
# DATABASE_URL=postgres://couture:<DB_PASSWORD>@localhost:5432/couture_mali

# ---- required: auth ----------------------------------------------------------
# Signing key for JWTs. MUST be unique per shop and long/random — anyone who
# knows it can mint a manager token. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# ---- required: the two operating accounts (seeded once) ----------------------
# Created by `npm run setup-shop` on an empty database, then managed in-app.
# There is no self-registration. Passwords must be at least 8 characters.
SEED_MANAGER_USERNAME=gerant
SEED_MANAGER_PASSWORD=
SEED_MANAGER_NAME=Le Gérant

SEED_SECRETARY_USERNAME=secretaire
SEED_SECRETARY_PASSWORD=
SEED_SECRETARY_NAME=La Secrétaire

# ---- required: shop identity -------------------------------------------------
# Shown on the login screen and on invoices, so each shop feels bespoke.
SHOP_NAME=Rayan Couture

# Fallback price per piece (FCFA, integer, no decimals) when a tailor has no
# rate of their own. The manager can change it later in Paramètres.

# Optional WhatsApp/social group link printed on invoices. Leave empty if none.
PROMO_GROUP_LINK=

# ---- optional: ports ---------------------------------------------------------
# Host port for this shop's API when several shops share one VPS (3001, 3002…).
# Inside the container the API always listens on 3000.
API_PORT=3000
# PORT=3000

# ---- optional: automatic WhatsApp notifications ------------------------------
# LEAVE ALL THREE EMPTY unless you have a paid provider account. When they are
# empty the server sends nothing and reports `not_configured` — it never claims
# a message was delivered. Shops without a provider use the wa.me button on the
# order screen, which needs no configuration at all.
# WHATSAPP_PROVIDER=ultramsg      # ultramsg | greenapi
# WHATSAPP_INSTANCE_ID=
# WHATSAPP_API_KEY=
